{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "mdview",
  "identifier": "dev.mdview.desktop",
  "build": {
    "frontendDist": "../dist",
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1450",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "mdview",
        "width": 960,
        "height": 760,
        "minWidth": 680,
        "minHeight": 360
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https: http:"
    }
  },
  "bundle": {
    "active": false
  }
}
