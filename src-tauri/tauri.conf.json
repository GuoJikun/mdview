{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "mdview",
  "identifier": "dev.mdview.desktop",
  "build": {
    "frontendDist": "../dist",
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1450",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "mdview",
        "width": 960,
        "height": 760,
        "minWidth": 680,
        "minHeight": 360,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https: http:"
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/GuoJikun/mdview/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDQ2QTI2RTA5RTk4RTkxRTMKUldUamtZN3BDVzZpUnVEZC9IbkthRjJRdXFONmJXWlhMNFdOTzZRalNFbStObnl6NVRGc0M4ZjAK"
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png"
    ]
  }
}
