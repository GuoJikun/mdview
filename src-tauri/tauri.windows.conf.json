{
  "$schema": "../gen/schemas/desktop-schema.json",
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "mdview",
        "width": 960,
        "height": 760,
        "minWidth": 680,
        "minHeight": 360,
        "decorations": false,
        "visible": false
      }
    ]
  },
  "bundle": {
    "icon": [
      "icons/32x32.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "targets": ["nsis"],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico",
        "displayLanguageSelector": true,
        "languages": ["English", "SimpChinese"]
      }
    }
  }
}
